MONGODB_URL=mongodb://dev:dev@127.0.0.1:27017/myapp?authSource=admin

# Optional. A GitHub personal access token for the backend's GitHub API calls.
# Without it, public repositories still work, at GitHub's lower rate limit (60 requests per hour).
GITHUB_TOKEN=

# Signing in with GitHub. Register an OAuth App at https://github.com/settings/developers
# with the callback URL http://127.0.0.1:5173/api/auth/github/callback (the Vite dev server),
# then copy its client id and a client secret here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional. The callback URL, when it is not this server's own address (for example behind a proxy).
GITHUB_CALLBACK_URL=

# Required. Seals each user's GitHub token before it is stored. At least 32 characters;
# make one with `openssl rand -base64 32`. Changing it signs everyone out of GitHub.
TOKEN_SECRET=
